<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup 已关（见 Manifest）：人物卡是用户资产，
     但跨设备自动备份会把 storage.json 里的 WebDAV 凭据一起搬走，语义不清。
     显式声明不参与备份。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
