<?xml version="1.0" encoding="utf-8"?>
<!--
  自签名证书的信任策略。

  为什么需要这个文件：**Android 7（API 24）起，应用默认不再信任用户自己安装的 CA。**
  也就是说用户把自建 WebDAV 服务器的证书装进手机，App 依然会连不上——
  这和「浏览器点一下继续访问」的直觉完全相反。

  这里显式放行 user 信任域，用户可以把自己服务器的 CA 导入「设置 → 安全 → 加密与凭据」
  之后正常同步。**这是零原生代码的方案**，代价是信任域是全局的、
  且证书透明度（CT）验证在这种配置下会被禁用。

  之后如果用户反馈「导入 CA 太麻烦」，再考虑走原生 HTTP 层做按指纹的交互式信任
  （即把桌面端 setCertificateVerifyProc 那套逻辑用 Kotlin 重写一遍）。
  在那之前不要提前做——那是整个移植里最贵的一块。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
