<?xml version="1.0" encoding="utf-8"?>
<!-- 品牌青色，取自 web/public/favicon.svg 的 fill（#00838f）。
     与桌面版图标同源，保证启动画面到界面不跳色。

     它同时是**自适应图标的背景层**（见 make-icon.mjs 生成的 ic_launcher.xml）：
     前景层是白色的 4E 字形（源图 alpha 取反）。两者不能再改成同一个颜色——
     0.3.4 就是这么发出一块纯青图标的：背景与前景都是这个青色，字完全看不见。 -->
<resources>
    <color name="brand_splash">#00838F</color>
</resources>
